{
  "name": "dsh-session-radar",
  "version": "1.1.0",
  "description": "DSH Web 侧边栏助手：⌘⇧K 弹出未读与待决策总览，⌘⇧J / ⌘⇧I 顺序定位未读与等待处理；另带六项会话状态读数（运行中 / 未读 / 待处理 / 闲置 / 未归档 / 已归档）与 host 半边的跨重启会话账本。",
  "type": "module",
  "license": "MIT",
  "author": "d0ublecl1ck",
  "contributors": [
    "Wei <minivv@users.noreply.github.com> (upstream dsh-activity-bell)"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d0ublecl1ck/dsh-session-radar.git"
  },
  "homepage": "https://github.com/d0ublecl1ck/dsh-session-radar",
  "bugs": {
    "url": "https://github.com/d0ublecl1ck/dsh-session-radar/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./activity-model": {
      "types": "./lib/activity-model.d.ts",
      "default": "./lib/activity-model.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "deepseek",
    "sidebar",
    "unread",
    "pending",
    "overview",
    "shortcuts",
    "status",
    "session-status",
    "counts",
    "ledger",
    "restart",
    "recovery",
    "session-radar"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "node scripts/build-tests.mjs && node --import ./test/register-css.mjs --test test/*.test.mjs",
    "verify": "npm run typecheck && npm run build && npm test",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-api-session-controller": "^0.1.0-rc.2 || ^0.1.1-rc.1 || ^0.1.2-alpha.2 || ^0.1.2-rc.1 || ^0.1.3-alpha.2 || ^0.1.5-alpha.1 || ^0.1.5-rc.1 || ^0.1.6-alpha.1 || ^0.1.7-alpha.1 || ^0.2.0-rc.1 || ^0.2.0-rc.2 || ^0.2.1-alpha.1",
